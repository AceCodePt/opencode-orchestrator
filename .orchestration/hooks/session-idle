#!/usr/bin/env bash
# session-idle — what "verify" means for this project.
#
# Fired by the router plugin when a child agent goes idle AND the files declared
# in ../config.json have actually changed. Named after the event, not the action.
#
# Provided by the dispatcher:
#   TASK_NAME  BRANCH_NAME  WORKTREE_PATH  WORKTREE_NAME  ORCH_EVENT  ORCH_SESSION_ID
#
# Contract: exit 0 = gate passed. Non-zero = failed, and everything written to
# stdout/stderr is fed back to the agent as a prompt. Keep failure output useful
# and bounded; it becomes the agent's instructions.

set -uo pipefail
cd "${WORKTREE_PATH:-$(git rev-parse --show-toplevel)}" || exit 1

status=0

# `-co --exclude-standard` lists tracked AND untracked-but-not-ignored files.
# Plain `git ls-files` lists only tracked ones, which means brand-new work is
# silently unchecked until it is committed — a gate that passes because it looked
# at nothing is worse than no gate.
mapfile -t candidates < <(git ls-files -co --exclude-standard)

is_shell() {
  case "$1" in
    *.sh) return 0 ;;
  esac
  # Otherwise trust the shebang. This directory holds Python too, and `bash -n`
  # on a Python file reports nonsense.
  [ -f "$1" ] || return 1
  head -c 80 "$1" 2>/dev/null | head -1 | grep -qE '^#!.*(\bsh|bash|zsh)\b'
}

is_python() {
  case "$1" in
    *.py) return 0 ;;
  esac
  [ -f "$1" ] || return 1
  head -c 80 "$1" 2>/dev/null | head -1 | grep -qE '^#!.*python'
}

shells=()
pys=()
for f in "${candidates[@]}"; do
  [ -f "$f" ] || continue
  if is_shell "$f"; then
    shells+=("$f")
  elif is_python "$f"; then
    pys+=("$f")
  fi
done

# --- shell -------------------------------------------------------------------
for f in "${shells[@]:-}"; do
  [ -n "$f" ] || continue
  if ! out=$(bash -n "$f" 2>&1); then
    echo "shell syntax error in $f:"
    echo "$out"
    status=1
  fi
done

if [ "${#shells[@]}" -gt 0 ] && command -v shellcheck >/dev/null 2>&1; then
  if ! out=$(shellcheck -S warning "${shells[@]}" 2>&1); then
    echo "shellcheck findings:"
    echo "$out"
    status=1
  fi
elif [ "${#shells[@]}" -gt 0 ]; then
  # Deliberate degradation: a gate that fails because a linter is absent gets
  # disabled by the first person it annoys. `orch doctor` reports the weakened
  # coverage instead.
  echo "note: shellcheck not installed, shell coverage is syntax-only" >&2
fi

# --- python ------------------------------------------------------------------
if [ "${#pys[@]}" -gt 0 ]; then
  if ! out=$(python3 -m py_compile "${pys[@]}" 2>&1); then
    echo "python compile errors:"
    echo "$out"
    status=1
  fi
  find . -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null
fi

# --- typescript --------------------------------------------------------------
# The router plugin was the only unchecked file in the repo, and it is the most
# fragile one: it runs inside someone else's runtime, so a type error surfaces as
# a plugin that silently fails to load and a gate that therefore never fires.
tsfiles=()
for f in "${candidates[@]}"; do
  case "$f" in *.ts) [ -f "$f" ] && tsfiles+=("$f") ;; esac
done

if [ "${#tsfiles[@]}" -gt 0 ]; then
  if command -v bun >/dev/null 2>&1; then
    for f in "${tsfiles[@]}"; do
      if ! out=$(bun build "$f" --target=node --outfile=/dev/null 2>&1); then
        echo "typescript build failed for $f:"
        echo "$out"
        status=1
      fi
    done
  else
    echo "note: bun not installed, typescript is unchecked" >&2
  fi
fi

# --- tests -------------------------------------------------------------------
# Discovered, not listed. A hardcoded list means a new test file is silently never
# run, and a gate that skips tests still reports success - the same class of
# blindness as the gate that only looked at tracked files.
ran=0
shopt -s nullglob
for t in tests/test_*.py; do
  ran=$((ran + 1))
  if ! out=$(python3 "$t" 2>&1); then
    echo "FAILED: $t"
    echo "$out"
    status=1
  fi
done

# TypeScript tests too, and discovered the same way. The plugin's fail-closed rules
# are the ones with no second chance: a wrongly skipped gate cannot be recovered by
# anything downstream, because the check simply never happened.
tstests=(tests/*.test.ts)
if [ "${#tstests[@]}" -gt 0 ]; then
  if command -v bun >/dev/null 2>&1; then
    ran=$((ran + ${#tstests[@]}))
    if ! out=$(bun test "${tstests[@]}" 2>&1); then
      echo "FAILED: bun test"
      echo "$out"
      status=1
    fi
  else
    echo "note: bun not installed, ${#tstests[@]} ts test file(s) unchecked" >&2
  fi
fi
shopt -u nullglob

if [ "$ran" -eq 0 ]; then
  echo "no test files found under tests/ - refusing to call that green" >&2
  status=1
fi

if [ "$status" -eq 0 ]; then
  echo "gate passed: ${#shells[@]} shell, ${#pys[@]} python, ${#tsfiles[@]} ts, $ran test files green"
fi
exit "$status"
