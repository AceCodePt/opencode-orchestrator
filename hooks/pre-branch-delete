#!/bin/bash
# pre-branch-delete - RDK Template project-specific cleanup
# Called by ~/.config/lazygit/scripts/delete-branch-with-worktree
#
# Environment variables provided:
#   BRANCH_NAME - The branch being deleted
#   WORKTREE_PATH - Path to the worktree (if found)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Normalize branch name to database name
NORMALIZED_BRANCH="${BRANCH_NAME//\//-}"
DB_NAME="reeeally_${NORMALIZED_BRANCH//-/_}"

CONTAINER_NAME="reeeally-postgres"

echo "🗄️  Checking for database: $DB_NAME"

# Check if container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
  echo "⚠️  PostgreSQL container not running, skipping database cleanup"
  exit 0
fi

# Check if database exists
if ! docker exec "$CONTAINER_NAME" psql -U postgres -lqt | cut -d \| -f 1 | grep -qw "$DB_NAME"; then
  echo "ℹ️  Database does not exist, nothing to clean up"
  exit 0
fi

# Delete database (auto-delete in non-interactive mode)
echo "🗑️  Deleting database: $DB_NAME"
if docker exec "$CONTAINER_NAME" psql -U postgres -c "DROP DATABASE ${DB_NAME};" >/dev/null 2>&1; then
  echo "✅ Database deleted"
else
  echo "❌ Failed to delete database"
  exit 1
fi
